# Copy this file to .env (which is gitignored) and fill in your real key.
# Never commit the real .env file.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Check https://aistudio.google.com/rate-limit for the current model with
# the most generous free daily quota before picking one. As of Sept 2026,
# gemini-3-flash has the best free-tier daily cap (~1500 req/day) and
# supports image input (needed for Step 29's math OCR).
GEMINI_MODEL=gemini-3-flash
