# Copy this file to .env (which is gitignored) and fill in your real key.
# Never commit the real .env file.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Run `python scripts/list_gemini_models.py` to see the real model names
# your key can call (docs/blogs can lag what's actually live -- both
# gemini-2.5-flash and gemini-3.8-flash returned 404s telling us to use
# this one instead). Confirmed working as of Sept 2026:
GEMINI_MODEL=gemini-3.6-flash
